{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.dev/schemas/visual-diff-v1.json",
  "title": "Aetherion visual diff report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "baseline", "candidate", "width", "height", "encoding", "channels", "bit_depth", "tolerances", "total_pixels", "different_pixels", "different_percent_milli", "maximum_observed_channel_delta", "sum_absolute_error", "mean_absolute_error", "passed", "first_differences"],
  "properties": {
    "schema": { "const": "aetherion.visual-diff/v1" },
    "baseline": { "type": "string" },
    "candidate": { "type": "string" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "encoding": { "type": "string" },
    "channels": { "type": "integer", "enum": [1, 3] },
    "bit_depth": { "type": "integer", "enum": [8, 16] },
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_channel_delta", "max_different_pixels", "max_different_percent_milli"],
      "properties": {
        "max_channel_delta": { "type": "integer", "minimum": 0 },
        "max_different_pixels": { "type": "integer", "minimum": 0 },
        "max_different_percent_milli": { "type": "integer", "minimum": 0, "maximum": 100000 }
      }
    },
    "total_pixels": { "type": "integer", "minimum": 1 },
    "different_pixels": { "type": "integer", "minimum": 0 },
    "different_percent_milli": { "$ref": "#/$defs/rational" },
    "maximum_observed_channel_delta": { "type": "integer", "minimum": 0 },
    "sum_absolute_error": { "type": "integer", "minimum": 0 },
    "mean_absolute_error": { "$ref": "#/$defs/rational" },
    "passed": { "type": "boolean" },
    "first_differences": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "deltas"],
        "properties": {
          "x": { "type": "integer", "minimum": 0 },
          "y": { "type": "integer", "minimum": 0 },
          "deltas": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "integer", "minimum": 0 } }
        }
      }
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
